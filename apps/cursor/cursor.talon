app: cursor
-
copy: key(ctrl-shift-c)
pasta: key(ctrl-shift-v)
search: "/"
replace:
    insert(":%s///g")
    key(left)
    key(left)
    key(left)

search everywhere: key(ctrl-shift-f)

go to file: key(ctrl-alt-f)
search file: key(ctrl-alt-f)

agent: key(ctrl-l)
inline edit: key(ctrl-k)

cursor settings: key(ctrl-shift-p)

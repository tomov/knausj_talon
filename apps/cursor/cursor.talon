app.name: Cursor
app.bundle: com.todesktop.230313mzl4w4u92
-
copy: key(cmd-c)
pasta: key(cmd-v)
search: "/"
replace:
    insert(":%s///g")
    key(left)
    key(left)
    key(left)

search everywhere: key(cmd-shift-f)

go to file: key(cmd-p)
search file: key(cmd-p)

agent: key(cmd-l)
new chat: key(cmd-shift-i)
inline edit: key(cmd-k)
fix in chat: key(cmd-shift-d)
quick fix: key(cmd-.)

cursor settings: key(cmd-shift-p)
command palette: key(cmd-shift-p)

start debugging: key(f5)
continue debugging: key(f5)
step over: key(f10)

plan mode: key(shift-tab)


# C++
see out: "std::cout<<"
end of line: "<<std::endl;"
const auto: "const auto "

app: cursor
-
copy: key(ctrl-shift-c)
#pasta: key(ctrl-shift-v)
pasta: key(ctrl-v)
search: "/"
replace:
    insert(":%s///g")
    key(left)
    key(left)
    key(left)

search everywhere: key(ctrl-shift-f)

go to file: key(ctrl-alt-f)
search file: key(ctrl-alt-f)

agent: key(ctrl-l)
inline edit: key(ctrl-k)
fix in chat: key(ctrl-shift-d)
quick fix: key(ctrl-.)

cursor settings: key(ctrl-shift-p)
command palette: key(ctrl-shift-p)

start debugging: key(f5)
continue: key(f5)
step over: key(f10)

plan mode: key(shift-tab)
